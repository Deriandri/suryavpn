<?xml version="1.0" encoding="utf-8"?>
<!-- BARU (permintaan user, "bikin smooth untuk perpindahan menu"): dipakai
     sebagai animasi MASUK activity tujuan tiap tap item bottom nav
     (Dashboard/Config/Settings/Tools), lihat NavTransitions.kt. Pola
     "fade through" Material Design: activity baru fade-in SEKALIGUS
     sedikit membesar dari 96% -> 100% (bukan cuma alpha polos) supaya
     transisinya terasa hidup, bukan cuma dim/terang. Durasi 220ms & kurva
     fastOutSlowIn dipilih supaya masih terasa cepat/responsif (bukan
     transisi lambat ala perpindahan halaman berhirarki), pas untuk pindah
     antar tab yang sederajat. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha
        android:duration="220"
        android:fromAlpha="0.0"
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:toAlpha="1.0" />
    <scale
        android:duration="220"
        android:fromXScale="0.96"
        android:fromYScale="0.96"
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1.0"
        android:toYScale="1.0" />
</set>
