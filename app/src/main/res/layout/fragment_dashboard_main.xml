<?xml version="1.0" encoding="utf-8"?>
<!-- Halaman "Main" dari Dashboard (geser kesamping <-> halaman "Log", lihat
     activity_dashboard.xml + DashboardPagerAdapter). Ini persis isi Dashboard
     lama, MINUS header (hamburger+judul, sekarang tetap/fixed di
     activity_dashboard.xml) dan MINUS baris menu "Log Koneksi" (sekarang jadi
     tab "Log" di sebelah kanan, bukan lagi item menu yang buka layar baru —
     lihat DashboardMainFragment.rowMenuLog).

     REDESIGN (permintaan user: "elegan, modern + smooth"):
     - Status pill + "Profil aktif" sekarang digabung jadi satu kartu "hero"
       bergradasi ungu di paling atas (ikon lencana + pill status + ringkasan
       profil), menggantikan pill polos + teks kecil terpisah seperti
       sebelumnya.
     - Card "Kontrol Koneksi" dapat sub-judul + tombol yang lebih besar dan
       memakai ikon power.
     - Semua id yang dipakai DashboardMainFragment.kt (pillStatus, tvStatus,
       tvActiveProfile, btnConnectToggle) TETAP dipertahankan persis, cuma
       gaya visualnya yang berubah - supaya kode Kotlin yang sudah ada
       tidak perlu diubah sama sekali.

     UPDATE (permintaan user): kartu "Tahapan Koneksi" (daftar bertitik/
     timeline, id lama tvLogEmpty + llLogSteps) DIHILANGKAN, diganti kartu
     "Catatan" (tvNotes) yang isinya dirender lewat HtmlCompat.fromHtml di
     DashboardMainFragment.renderNotes(), supaya ke depannya kartu ini bisa
     menampilkan teks berformat HTML apa pun. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:animateLayoutChanges="true">

        <!-- Kartu "hero": ikon lencana + status + ringkasan profil aktif,
             digabung dalam satu kartu bergradasi supaya jadi titik fokus
             utama halaman (sebelumnya: pill status polos + baris teks kecil
             terpisah tanpa hierarki visual yang jelas). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_hero_gradient"
            android:elevation="6dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginBottom="20dp">

            <!-- Lencana ikon VPN, lingkaran putih transparan di atas gradasi. -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_hero_icon_badge"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_vpn_status"
                    android:contentDescription="@null" />
            </FrameLayout>

            <!-- Pill status: DIPERTAHANKAN persis id & strukturnya (pillStatus,
                 tvStatus) karena warna latar & teksnya diganti dinamis lewat
                 DashboardMainFragment.applyStatusPillColor()
                 (pillStatus.background as GradientDrawable). Sekarang dibuat
                 wrap_content & center supaya tampil sebagai "chip" mengambang
                 di tengah kartu hero, bukan lagi bar penuh selebar layar. -->
            <LinearLayout
                android:id="@+id/pillStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_status_pill"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belum tersambung"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- REDESIGN (permintaan user: tampilan "Profil aktif" lebih
                 profesional/modern/smooth). Sebelumnya teks polos
                 mengambang langsung di atas gradasi hero, sekarang
                 dibungkus jadi "chip" kaca (bg_pill_ghost_on_hero, sama
                 seperti dipakai "Ganti Akun" di bawahnya supaya senada)
                 + titik indikator kecil di depan teks — konsisten dengan
                 pola "status dot" yang sudah dipakai di kartu Log
                 (bg_dot_glow). tvActiveProfile TETAP id & jenis View yang
                 sama persis (TextView polos) — DashboardMainFragment.kt
                 masih cuma nulis .text ke situ, tidak ada perubahan Kotlin
                 sama sekali. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill_ghost_on_hero"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_dot_active_profile" />

                <TextView
                    android:id="@+id/tvActiveProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Profil aktif: belum ada konfigurasi"
                    android:textColor="@color/text_on_hero_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- FITUR BARU (permintaan user): pemilih akun tersimpan langsung
                 dari Dashboard — cuma tampil kalau ada LEBIH DARI SATU akun
                 (lihat DashboardMainFragment.refreshAccountPickerVisibility),
                 supaya tidak ramai tanpa guna kalau cuma ada satu/nol akun.
                 Tap membuka BottomSheetDialog "Pilih Akun"
                 (DashboardMainFragment.showAccountPicker). -->
            <LinearLayout
                android:id="@+id/rowSwitchAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill_ghost_on_hero"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ganti Akun"
                    android:textColor="@color/text_on_hero"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card: Kontrol Koneksi (Connect & Disconnect satu tempat) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="Kontrol Koneksi" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Satu tombol untuk menyambungkan atau memutus tunnel Anda"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <!-- Tombol tunggal: Connect/Disconnect digabung jadi satu toggle,
                     tampilan & aksinya berubah sesuai status tunnel saat ini
                     (lihat DashboardMainFragment.applyConnectButtonState).
                     Diperbesar (56dp) & ditambah ikon power supaya lebih
                     tegas sebagai aksi utama halaman ini. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectToggle"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Connect"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:letterSpacing="0.01"
                    app:icon="@drawable/ic_power"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Catatan (menggantikan tampilan "Tahapan Koneksi" yang lama,
             dipindahkan dari tab Log, lihat DashboardLogFragment/
             fragment_dashboard_log.xml lama). PERMINTAAN USER: tampilan
             daftar tahap bertitik/timeline DIHILANGKAN, diganti kartu
             catatan sederhana satu TextView (tvNotes) yang isinya dirender
             lewat HtmlCompat.fromHtml (lihat
             DashboardMainFragment.renderNotes()) supaya ke depannya bisa
             menampilkan teks berformat HTML apa pun (bold/warna/link/dst),
             bukan cuma daftar status kaku. textIsSelectable supaya isi
             catatan bisa disalin user seperti halnya di tab Log. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Catatan" />

                <TextView
                    android:id="@+id/tvNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="2dp"
                    android:textIsSelectable="true"
                    android:autoLink="web"
                    android:text="Belum ada catatan. Tekan Connect di tab Main untuk memulai."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card "Menu" (Konfigurasi SSH/Xray + Log Koneksi) SUDAH DIHAPUS
             dari halaman Main — semua navigasinya sudah tersedia lewat jalur
             lain: Konfigurasi SSH/Xray lewat tab "Konfigurasi" di bilah
             navigasi bawah (lihat ConfigActivity), Log Koneksi lewat tab
             "Log" di atas / geser layar ke kanan (lihat DashboardPagerAdapter
             & DashboardLogFragment). -->

    </LinearLayout>
</ScrollView>
