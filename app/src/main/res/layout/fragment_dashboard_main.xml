<?xml version="1.0" encoding="utf-8"?>
<!-- Halaman "Main" dari Dashboard (geser kesamping <-> halaman "Log", lihat
     activity_dashboard.xml + DashboardPagerAdapter). Ini persis isi Dashboard
     lama, MINUS header (hamburger+judul, sekarang tetap/fixed di
     activity_dashboard.xml) dan MINUS baris menu "Log Koneksi" (sekarang jadi
     tab "Log" di sebelah kanan, bukan lagi item menu yang buka layar baru —
     lihat DashboardMainFragment.rowMenuLog). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:animateLayoutChanges="true">

        <!-- Status headline dipindahkan ke activity_dashboard.xml, tepat di
             bawah tab "Main | Log" (fixed, tidak ikut halaman Main/Log yang
             bisa digeser) -- lihat pillStatus di sana & setupStatusPill()
             di DashboardActivity. -->

        <!-- Card: Tahapan Koneksi (dipindahkan dari tab Log, lihat
             DashboardLogFragment/fragment_dashboard_log.xml lama, sekarang
             tampil di Main, tepat di atas "Profil aktif", supaya progres
             tahapan koneksi terlihat langsung tanpa pindah tab). -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tahapan Koneksi" />

                <TextView
                    android:id="@+id/tvLogEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Belum ada aktivitas koneksi. Tekan Connect di tab Main untuk memulai."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/llLogSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:animateLayoutChanges="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvActiveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="4dp"
            android:text="Profil aktif: belum ada konfigurasi"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Card: Kontrol Koneksi (Connect & Disconnect satu tempat) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kontrol Koneksi" />

                <!-- Tombol tunggal: Connect/Disconnect digabung jadi satu toggle,
                     tampilan & aksinya berubah sesuai status tunnel saat ini
                     (lihat DashboardMainFragment.applyConnectButtonState). -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectToggle"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Connect"
                    android:textAllCaps="false"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card "Menu" (Konfigurasi SSH/Xray + Log Koneksi) SUDAH DIHAPUS
             dari halaman Main — semua navigasinya sudah tersedia lewat jalur
             lain: Konfigurasi SSH/Xray lewat tab "Konfigurasi" di bilah
             navigasi bawah (lihat ConfigActivity), Log Koneksi lewat tab
             "Log" di atas / geser layar ke kanan (lihat DashboardPagerAdapter
             & DashboardLogFragment). -->

    </LinearLayout>
</ScrollView>
