<?xml version="1.0" encoding="utf-8"?>
<!-- Halaman "Log" dari Dashboard (geser kesamping <-> halaman "Main", lihat
     activity_dashboard.xml + DashboardPagerAdapter).

     REDESIGN (permintaan user: "elegan, modern, smooth" - sama seperti
     fragment_dashboard_main.xml sebelumnya): kartu Terminal yang tadinya
     full-bleed nempel tepi layar dengan sudut lancip 0dp & pembatas garis
     1dp kiri-kanan sekarang jadi kartu mengambang bersudut membulat +
     bayangan (konsisten dengan gaya kartu di tab Main), dot status dikasih
     efek glow, dan tombol "Hapus Log" jadi pill tipis supaya kelihatan
     sebagai tombol. Kartu tetap mengisi PENUH sisa tinggi layar
     (layout_height="0dp" + layout_weight="1"), cuma sekarang ada margin
     16dp di sekelilingnya alih-alih nempel tepi. Isi gradasi
     putih->biru muda di dalamnya (bg_terminal_log) TIDAK diubah, itu
     preferensi user dari permintaan sebelumnya. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Card: Terminal log mentah (real-time, event asli - lihat StatusBus.log). -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Card.Section"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/terminal_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header: judul + tombol hapus, tinggi tetap -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">

                <!-- Dot dengan efek glow (halo tipis di belakang titik solid),
                     lebih hidup dibanding titik datar polos. -->
                <View
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_dot_glow"
                    android:backgroundTint="@color/terminal_accent" />

                <TextView
                    style="@style/SectionTitleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:letterSpacing="0.02"
                    android:textColor="@color/terminal_accent"
                    android:text="Terminal" />

                <!-- Pill tipis supaya kelihatan sebagai tombol, bukan cuma
                     label teks tanpa latar seperti sebelumnya. -->
                <TextView
                    android:id="@+id/btnClearLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hapus Log"
                    android:textColor="@color/terminal_text_dim"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <!-- Garis pemisah tipis header <-> isi log, pakai warna khusus
                 terminal (putih transparan) karena garis "divider" biasa
                 dirancang untuk kartu putih, tidak kelihatan di latar gelap. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="@color/terminal_divider" />

            <!-- Isi log: mengisi SISA ruang kartu (weight=1). Sekarang punya
                 sedikit "napas" (margin bawah) dari tepi kartu supaya
                 terlihat sebagai panel tersendiri yang membulat, senada
                 dengan kartu pembungkusnya, bukan nempel rata ke tepi kartu. -->
            <com.example.tunnelapp.ui.TerminalScrollView
                android:id="@+id/svTerminal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_terminal_log"
                android:scrollbars="vertical"
                android:fadeScrollbars="false"
                android:overScrollMode="always"
                android:clipToOutline="true">

                <TextView
                    android:id="@+id/tvTerminal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="10.5sp"
                    android:textColor="@color/terminal_text"
                    android:lineSpacingExtra="3dp"
                    android:padding="10dp"
                    android:textIsSelectable="true"
                    android:text="" />
            </com.example.tunnelapp.ui.TerminalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
