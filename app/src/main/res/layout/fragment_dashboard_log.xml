<?xml version="1.0" encoding="utf-8"?>
<!-- Halaman "Log" dari Dashboard (geser kesamping <-> halaman "Main", lihat
     activity_dashboard.xml + DashboardPagerAdapter). Isinya sama persis
     dengan activity_log.xml yang lama, MINUS top bar back-button + judul
     (sekarang sudah ada tab "Main | Log" + header yang fixed di
     activity_dashboard.xml, jadi tidak perlu tombol back lagi di sini). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:animateLayoutChanges="true">

        <!-- Card: Log Koneksi -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tahapan Koneksi" />

                <TextView
                    android:id="@+id/tvLogEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Belum ada aktivitas koneksi. Tekan Connect di tab Main untuk memulai."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/llLogSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:animateLayoutChanges="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Terminal log mentah (real-time, event asli - lihat StatusBus.log) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            app:cardBackgroundColor="#0D0F14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        style="@style/SectionTitleText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#B7C4D0"
                        android:text="Terminal" />

                    <TextView
                        android:id="@+id/btnClearLog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hapus Log"
                        android:textColor="#B7C4D0"
                        android:textSize="12sp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <com.example.tunnelapp.ui.TerminalScrollView
                    android:id="@+id/svTerminal"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false"
                    android:overScrollMode="always">

                    <TextView
                        android:id="@+id/tvTerminal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="11.5sp"
                        android:textColor="#8FE38F"
                        android:textIsSelectable="true"
                        android:text="" />
                </com.example.tunnelapp.ui.TerminalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
