<?xml version="1.0" encoding="utf-8"?>
<!-- Halaman "Log" dari Dashboard (geser kesamping <-> halaman "Main", lihat
     activity_dashboard.xml + DashboardPagerAdapter).

     REDESIGN (permintaan user: "full tampilan, hilangkan Terminal + tombol
     Hapus dibikin ngambang"): kartu bermargin+bersudut membulat dari versi
     sebelumnya DIBUANG — svTerminal sekarang mengisi PENUH seluruh halaman
     (match_parent x match_parent, tanpa padding/margin), header "Terminal"
     (dot glow + judul teks) & garis pemisahnya DIHAPUS TOTAL. Tombol "Hapus
     Log" TIDAK hilang (fungsinya tetap ada, cuma posisinya pindah) — jadi
     pill MENGAMBANG (elevation, latar semi-solid bg_pill_floating) yang
     ditumpuk (FrameLayout) tepat di pojok kanan-atas area log, "ngambang"
     persis di atas isi terminal seperti diminta, bukan lagi baris header
     terpisah di atas kartu. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Isi log: UPDATE (permintaan user) — bg_terminal_log_full sekarang
         biru smooth + garis tepi tipis + sudut membulat di setiap sisi
         (bukan lagi hitam edge-to-edge tanpa sudut). Diberi margin 14dp di
         semua sisi supaya lekukan sudut & garis tepinya kelihatan (kalau
         match_parent tanpa margin, sudutnya akan terpotong rata di tepi
         layar). Padding atas tetap dilebihkan supaya baris log paling atas
         tidak ketimpa tombol "Hapus Log" yang mengambang di atasnya. -->
    <com.example.tunnelapp.ui.TerminalScrollView
        android:id="@+id/svTerminal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="14dp"
        android:background="@drawable/bg_terminal_log_full"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:overScrollMode="always"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvTerminal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="10.5sp"
            android:textColor="@color/terminal_text"
            android:lineSpacingExtra="3dp"
            android:paddingHorizontal="14dp"
            android:paddingTop="40dp"
            android:paddingBottom="14dp"
            android:textIsSelectable="true"
            android:text="" />
    </com.example.tunnelapp.ui.TerminalScrollView>

    <!-- Tombol "Hapus Log" MENGAMBANG di pojok kanan-atas, di atas isi log
         (FrameLayout menumpuknya di atas svTerminal). Latar lebih solid +
         garis tepi tipis (bg_pill_floating, beda dari bg_pill_ghost lama
         yang nyaris transparan) + elevation supaya tetap kebaca/kelihatan
         sebagai tombol walau warna log di belakangnya berubah-ubah. Margin
         disesuaikan (14dp margin svTerminal + 12dp jarak) supaya tombol
         tetap pas menumpuk di dalam kartu biru barunya, tidak nabrak sudut
         membulat.
         DIPERKECIL (permintaan user: "log kepepet ke atas, ruang kosong
         kebanyakan") -- marginTop & paddingVertical tombol dikurangi supaya
         tombol ikut naik, lalu paddingTop tvTerminal di atas ikut dikurangi
         proporsional (56dp -> 40dp) supaya baris log PALING ATAS tetap tidak
         ketimpa tombol yang sekarang lebih pendek & lebih naik. -->
    <TextView
        android:id="@+id/btnClearLog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:elevation="4dp"
        android:text="Hapus Log"
        android:textColor="@color/terminal_text_dim"
        android:textSize="12sp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="@drawable/bg_pill_floating"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless" />

</FrameLayout>
