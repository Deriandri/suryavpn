<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:animateLayoutChanges="true">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Konfigurasi SSH"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card: Metode Koneksi -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:animateLayoutChanges="true">

                <TextView
                    style="@style/SectionTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Metode Koneksi" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:chipSpacingHorizontal="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSsh"
                        style="@style/Widget.TunnelApp.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="SSH" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSshSsl"
                        style="@style/Widget.TunnelApp.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SSH SSL" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSshEnhanced"
                        style="@style/Widget.TunnelApp.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SSH TLS Payload Proxy" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPayloadRemoteProxy"
                        style="@style/Widget.TunnelApp.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payload + Remote Proxy" />
                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSni"
                    style="@style/Field.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="SNI (kosongkan jika tidak perlu)"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSni"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/containerTlsVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Versi TLS"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupTlsVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:chipSpacingHorizontal="8dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTlsDefault"
                            style="@style/Widget.TunnelApp.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Default" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTlsV1"
                            style="@style/Widget.TunnelApp.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TLSv1" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTlsV11"
                            style="@style/Widget.TunnelApp.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TLSv1.1" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTlsV12"
                            style="@style/Widget.TunnelApp.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TLSv1.2" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTlsV13"
                            style="@style/Widget.TunnelApp.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TLSv1.3" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipIgnoreCertErrors"
                    style="@style/Widget.TunnelApp.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:checkable="true"
                    android:text="Abaikan error sertifikat TLS (self-signed)"
                    android:visibility="gone" />

                <!-- FITUR BARU (permintaan user): grup "Remote Proxy" (label + toggle
                     Raw Passthrough + host/port proxy) DIPISAH jadi satu blok
                     tersendiri; sebelumnya chip Raw Passthrough nempel sendirian
                     tepat di bawah baris chip mode, sedangkan host/port proxy
                     terpisah jauh di bawah field TLS, jadi tidak kelihatan sebagai
                     satu kesatuan. Sekarang keduanya digabung dalam satu blok
                     berlabel "Remote Proxy", diletakkan setelah field TLS/SNI dasar
                     supaya urutan Metode Koneksi lebih rapi: pilih mode -> field
                     dasar (SNI/TLS/cert) -> baru field lanjutan proxy remote (kalau
                     mode-nya memang mendukung, lihat
                     SshConfigActivity.updateFieldVisibilityForMode; satu
                     visibility untuk seluruh blok ini, bukan dua terpisah lagi). -->
                <LinearLayout
                    android:id="@+id/containerRemoteProxy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remote Proxy"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupEnhancedToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:singleSelection="false"
                        app:selectionRequired="false"
                        app:chipSpacingHorizontal="8dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipRawMode"
                            style="@style/Widget.TunnelApp.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Raw Passthrough (CDN, skip CONNECT)" />
                    </com.google.android.material.chip.ChipGroup>

                    <LinearLayout
                        android:id="@+id/containerProxy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilProxyHost"
                            style="@style/Field.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:layout_marginEnd="8dp"
                            android:hint="Host / IP Proxy (opsional)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etProxyHost"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textUri"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"
                                android:autofillHints="" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilProxyPort"
                            style="@style/Field.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Port Proxy">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etProxyPort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"
                                android:autofillHints="" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPayload"
                    style="@style/Field.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Payload custom, contoh: GET / HTTP/1.1[crlf]Host: [host][crlf][crlf]"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPayload"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- FITUR BARU (permintaan user): Path WebSocket & Header HTTP
                     tambahan disembunyikan di balik toggle "Opsi Lanjutan"
                     supaya form tidak penuh dengan field yang jarang dipakai;
                     baris ini murni tombol buka/tutup, logika aktif/tidak-
                     aktifnya (redup saat tidak dipakai mode saat ini) tetap
                     sama seperti sebelumnya, lihat updateWsAndHeaderFieldState
                     & SshConfigActivity.onCreate (auto-expand kalau salah
                     satu field sudah terisi waktu edit akun lama). -->
                <LinearLayout
                    android:id="@+id/rowToggleAdvanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivToggleAdvancedGear"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_nav_settings"
                        app:tint="@color/brand_primary"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvToggleAdvancedLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Opsi Lanjutan (Path WebSocket, Header HTTP)"
                        android:textColor="@color/brand_primary"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/ivToggleAdvancedChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:rotation="0"
                        android:src="@drawable/ic_chevron_forward"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llAdvancedFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <!-- WebSocket sekarang SELALU dicoba di semua mode (lihat
                     ServerConfig.usesWebSocket()), jadi field ini selalu
                     ditampilkan (tidak ikut disembunyikan/diperlihatkan per
                     mode seperti field lain di atas, lihat
                     updateFieldVisibilityForMode() di SshConfigActivity). -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilWsPath"
                    style="@style/Field.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Path WebSocket, contoh: /ssh-ws (kosongkan untuk &quot;/&quot;)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWsPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Header HTTP custom - berlaku untuk request CONNECT proxy DAN
                     handshake WebSocket genuine (lihat ServerConfig.customHeaders).
                     Selalu ditampilkan (tidak digantung ke mode tertentu) sama
                     seperti field Path WebSocket di atas, karena keduanya independen
                     dari mode koneksi yang dipilih. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCustomHeaders"
                    style="@style/Field.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Header HTTP tambahan (opsional), 1 per baris, contoh: X-Online-Host: [host]">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCustomHeaders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Konfigurasi Server -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Konfigurasi Server" />

                <!-- FITUR BARU (permintaan user): nama akun custom, murni buat
                     tampilan (daftar "Akun Tersimpan" & pemilih akun di
                     Dashboard) — tidak memengaruhi koneksi sama sekali.
                     Kosong = tetap tampil sebagai host:port seperti sebelumnya. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAccountName"
                    style="@style/Field.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:hint="Nama Akun (opsional)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAccountName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilQuickPaste"
                        style="@style/Field.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="Tempel cepat info server">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etQuickPaste"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:autofillHints="" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickPasteApply"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Terapkan"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_paste"
                        app:iconGravity="end"
                        app:iconPadding="6dp"
                        app:iconTint="@color/brand_primary"
                        style="@style/Widget.Material3.Button.TonalButton" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tempel cepat: host:port@username:password, lalu tekan Terapkan"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilHost"
                    style="@style/Field.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Host / IP Server SSH">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/rowPortUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="Port">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="22"
                            android:inputType="number"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:autofillHints="" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:hint="Username">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:autofillHints="username" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Field.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="password_toggle"
                    android:hint="Password">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:autofillHints="password" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: DNS; DISEMBUNYIKAN dari layar ini (permintaan user).
             Field etDns1/etDns2 SENGAJA TIDAK DIHAPUS (cuma visibility=gone)
             supaya SshConfigActivity.kt (restoreSavedConfig/onSaveClicked,
             yang masih membaca/menulis binding.etDns1/etDns2 ke
             SavedConfig.dns1/dns2) tidak perlu diubah & tetap kompilasi;
             DNS per-profil ini sekarang cuma efektif diisi dari data lama
             (kalau ada). Kartu "Pengaturan > VPN Setting" SUDAH TIDAK PUNYA
             field DNS manual lagi, cuma switch "DNS Default Otomatis"
             (dnsFallbackEnabled) yang menentukan apakah DNS default
             (1.1.1.1) dipasang saat DNS1/DNS2 di sini kosong dua-duanya
             (lihat VpnSettingsStore & MyVpnService.applyDnsServers). -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DNS" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Berlaku untuk profil SSH maupun Xray. Kosongkan untuk pakai default (1.1.1.1)."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="DNS 1 (mis. 1.1.1.1)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDns1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:autofillHints="" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="DNS 2 (opsional)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDns2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:autofillHints="" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSsh"
            style="@style/Button.Primary"
