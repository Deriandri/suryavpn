<?xml version="1.0" encoding="utf-8"?>
<!-- Root DrawerLayout — header + tab "Main | Log" TETAP (fixed) di atas,
     kontennya sekarang ViewPager2 yang bisa DIGESER KE SAMPING antara
     halaman "Main" (fragment_dashboard_main.xml, dashboard yang sudah ada)
     dan "Log" (fragment_dashboard_log.xml, dipindahkan dari LogActivity ke
     bagian kanan Dashboard) — lihat DashboardPagerAdapter &
     DashboardActivity.setupPager(). Bottom nav & sidebar (NavigationView)
     tetap dipertahankan sama seperti sebelumnya. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<!-- Konten utama Dashboard — WAJIB match_parent/match_parent supaya
     DrawerLayout tahu ini layer konten utama, bukan si drawer. -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <!-- Header: ikon hamburger (buka sidebar) + judul — fixed, tidak ikut
         digeser/discroll oleh ViewPager2 di bawahnya. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnOpenDrawer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu_hamburger"
            android:tint="@color/text_primary"
            android:contentDescription="Buka menu" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TunnelApp"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tab "Main | Log" — fixed juga, tapi TERHUBUNG ke ViewPager2 lewat
         TabLayoutMediator (DashboardActivity.setupPager()) supaya: (1) tap
         tab pindah halaman, dan (2) geser halaman ikut menggerakkan
         indikator tab, persis seperti video referensi. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/brand_primary"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="@color/brand_primary"
        app:tabTextColor="@color/text_secondary"
        app:tabTextAppearance="@style/TextAppearance.Material3.TitleSmall" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Status headline card DIHAPUS dari sini (permintaan user): sebelumnya
         fixed di bawah tab Main|Log sehingga ikut tampil juga di halaman
         "Log" dan membuat area Terminal terasa sempit. Sekarang dipindahkan
         SEPENUHNYA ke dalam halaman "Main" saja (lihat pillStatus di
         fragment_dashboard_main.xml, paling atas, & DashboardMainFragment.
         setupStatusPill()) -- halaman "Log" jadi penuh satu layar untuk
         Terminal, dan status cuma terlihat waktu ada di tab Main. -->

    <!-- Konten geser-kesamping: halaman 0 = Main, halaman 1 = Log. -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/dashboardPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bilah navigasi bawah: Dashboard (layar ini) & Pengaturan (konfigurasi
         SSH/Xray + info app). Lihat DashboardActivity.setupBottomNav(). -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.TunnelApp.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
<!-- /Konten utama Dashboard -->

<!-- Sidebar: nempel di kiri (start), lebar wrap_content dibatasi lewat
     android:layout_width standar Material (max 320dp otomatis oleh
     NavigationView kalau match_parent — di sini pakai wrap_content dengan
     minWidth lewat style bawaan komponennya). -->
<com.google.android.material.navigation.NavigationView
    android:id="@+id/navDrawer"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/card_background"
    app:itemIconTint="@color/text_primary"
    app:itemTextColor="@color/text_primary"
    app:headerLayout="@layout/nav_drawer_header"
    app:menu="@menu/nav_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
