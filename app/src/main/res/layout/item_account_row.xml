<?xml version="1.0" encoding="utf-8"?>
<!-- REDESIGN (permintaan user: "profesional, modern, smooth"). Sebelumnya
     root-nya LinearLayout polos (satu baris di antara baris lain, dipisah
     "dividerRow" tipis) yang ditumpuk di DALAM satu MaterialCardView besar
     "Akun Tersimpan" di activity_config.xml. Sekarang root-nya SENDIRI
     sebuah MaterialCardView (style Card.Account — sudut lebih bulat +
     elevasi tipis), jadi tiap akun kartu sendiri-sendiri dengan jarak
     (marginBottom) di antaranya — makanya dividerRow yang dulu DIHAPUS
     (tidak perlu lagi, "pemisah" sekarang jarak antar kartu itu sendiri;
     lihat juga ConfigActivity.refreshAccountsList() yang dulu
     menyembunyikan dividerRow di baris terakhir, sekarang dihapus juga). -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Card.Account"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- REDESIGN (permintaan user: "susunan tulisan konfigurasi agar
             enak dipandang"). Sebelumnya btnRowShare/Edit/Delete satu baris
             dengan avatar+badge+title, jadi title/host cuma kebagian sisa
             ruang sempit dan sering keputus jadi "host...4..." yang nyaris
             tidak terbaca. Sekarang baris atas HANYA avatar + badge/title/
             subtitle (lebar penuh kartu), ikon aksi dipindah gabung ke
             baris bawah bareng status "Aktif"/"Jadikan Aktif" (status di
             kiri, aksi di kanan), title/host jadi jauh lebih jarang
             terpotong. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp">

                <View
                    android:id="@+id/ivRowAvatarBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_ssh" />

                <ImageView
                    android:id="@+id/ivRowIcon"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_account_ssh"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRowTypeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_brand_soft"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginBottom="4dp"
                    android:text="SSH"
                    android:textColor="@color/brand_primary"
                    android:textStyle="bold"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvRowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="host:port"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="14.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- FITUR BARU (permintaan user, nama akun): cuma ditampilkan
                     kalau akun ini punya nama custom — di keadaan itu
                     tvRowTitle di atas menampilkan NAMA-nya, dan baris ini
                     menampilkan host:port sebagai keterangan tambahan.
                     Kalau tidak ada nama custom, baris ini tetap disembunyikan
                     (tvRowTitle sendiri sudah cukup, persis perilaku lama). -->
                <TextView
                    android:id="@+id/tvRowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="host:port"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginStart="56dp">

            <TextView
                android:id="@+id/tvRowActiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_active"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="✓ Aktif"
                android:textColor="@color/status_success"
                android:textStyle="bold"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvRowSetActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_neutral_outline"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Jadikan Aktif"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <!-- Spacer: dorong ikon aksi ke ujung kanan baris, senada
                 dengan status di kiri (lihat catatan REDESIGN di atas). -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- FITUR BARU (permintaan user): Bagikan akun ini sebagai kode
                 teks singkat (lihat ConfigActivity.onShareRowClicked &
                 model/ConfigIO.buildShareCode). Ditaruh SEBELUM Edit/Hapus
                 (urutan tindakan makin "berat" dari kiri ke kanan). -->
            <ImageView
                android:id="@+id/btnRowShare"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:src="@drawable/ic_share"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Bagikan" />

            <ImageView
                android:id="@+id/btnRowEdit"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:src="@drawable/ic_edit_pencil"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Edit" />

            <ImageView
                android:id="@+id/btnRowDelete"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_delete_trash"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Hapus" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
