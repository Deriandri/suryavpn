<?xml version="1.0" encoding="utf-8"?>
<!-- REDESIGN (permintaan user: "gabungkan card akun tersimpan, rapikan
     susunannya"). Sebelumnya root-nya MaterialCardView sendiri (style
     Card.Account) dengan marginBottom, jadi tiap akun kartu terpisah-pisah
     bertumpuk di dalam activity_config.xml. Sekarang root-nya LinearLayout
     polos, jadi BARIS BIASA di dalam satu kartu besar "Akun Tersimpan"
     (lihat activity_config.xml) — dipisah oleh "dividerRow" tipis di atas
     tiap baris (disembunyikan untuk baris PERTAMA lewat
     ConfigActivity.refreshAccountsList(), persis pola divider antara baris
     "Konfigurasi SSH"/"Konfigurasi Xray" di kartu atasnya). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/dividerRow"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- REDESIGN (permintaan user: "susunan tulisan konfigurasi agar
             enak dipandang"). Baris atas HANYA avatar + badge/title/
             subtitle (lebar penuh), ikon aksi digabung ke baris bawah
             bareng status "Aktif"/"Jadikan Aktif" (status di kiri, aksi di
             kanan), supaya title/host jarang terpotong. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp">

                <View
                    android:id="@+id/ivRowAvatarBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_ssh" />

                <ImageView
                    android:id="@+id/ivRowIcon"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_account_ssh"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRowTypeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_brand_soft"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginBottom="4dp"
                    android:text="SSH"
                    android:textColor="@color/brand_primary"
                    android:textStyle="bold"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvRowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="host:port"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="14.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- FITUR BARU (permintaan user, nama akun): cuma ditampilkan
                     kalau akun ini punya nama custom — di keadaan itu
                     tvRowTitle di atas menampilkan NAMA-nya, dan baris ini
                     menampilkan host:port sebagai keterangan tambahan.
                     Kalau tidak ada nama custom, baris ini tetap disembunyikan
                     (tvRowTitle sendiri sudah cukup, persis perilaku lama). -->
                <TextView
                    android:id="@+id/tvRowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="host:port"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginStart="56dp">

            <TextView
                android:id="@+id/tvRowActiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_active"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="✓ Aktif"
                android:textColor="@color/status_success"
                android:textStyle="bold"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvRowSetActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_neutral_outline"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Jadikan Aktif"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <!-- FITUR BARU (permintaan user, "cek ping/latency server"):
                 badge kecil menampilkan hasil TCP ping terakhir akun ini
                 (lihat PingUtil.tcpPing & ConfigActivity.onTestPingAllClicked/
                 bindAccountRow) — tersembunyi (GONE) sampai tombol "Tes
                 Ping Semua Server" pernah ditekan minimal sekali. Warna
                 latar & teksnya diubah runtime (hijau=cepat, oranye=sedang,
                 merah=lambat/gagal), lihat bg_pill_ping.xml. -->
            <TextView
                android:id="@+id/tvRowPing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_ping"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="-- ms"
                android:textStyle="bold"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <!-- Spacer: dorong ikon aksi ke ujung kanan baris, senada
                 dengan status di kiri (lihat catatan REDESIGN di atas). -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- FITUR BARU (permintaan user): Bagikan akun ini sebagai kode
                 teks singkat (lihat ConfigActivity.onShareRowClicked &
                 model/ConfigIO.buildShareCode). Ditaruh SEBELUM Edit/Hapus
                 (urutan tindakan makin "berat" dari kiri ke kanan). -->
            <!-- FITUR BARU (permintaan user, "kunci akun"): gembok untuk
                 kunci/buka kunci akun ini. Kalau terkunci, tombol Edit &
                 Hapus di sebelah kanan otomatis dipudarkan & diblokir
                 (lihat ConfigActivity.bindAccountRow/onLockRowClicked).
                 Ditaruh PALING KIRI dari grup ikon aksi (proteksi dulu,
                 baru aksi lain) sebelum ikon Bagikan/Edit/Hapus. -->
            <ImageView
                android:id="@+id/btnRowLock"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:src="@drawable/ic_lock_open"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Kunci akun" />

            <ImageView
                android:id="@+id/btnRowShare"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:src="@drawable/ic_share"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Bagikan" />

            <ImageView
                android:id="@+id/btnRowEdit"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:src="@drawable/ic_edit_pencil"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Edit" />

            <ImageView
                android:id="@+id/btnRowDelete"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_delete_trash"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Hapus" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
