<?xml version="1.0" encoding="utf-8"?>
<!-- REDESIGN (permintaan user: kartu "Tahapan Koneksi" lebih profesional/
     modern/smooth): sebelumnya cuma titik warna polos + label sejajar kiri,
     TIDAK ada penanda urutan/alur antar tahap. Sekarang jadi pola "timeline/
     stepper" — badge lingkaran per tahap (isi ikon centang/silang utk
     sukses/gagal, titik kecil utk belum jalan, spinner utk lagi berjalan)
     DIHUBUNGKAN garis vertikal tipis ke tahap sebelum & sesudahnya, senada
     pola stepper yang umum dipakai app modern (mis. tracking pengiriman).
     Semua id lama (dot, spinner, tvLabel, tvDetail) TETAP dipertahankan
     supaya sebagian logika Kotlin lama tidak perlu ditulis ulang total —
     cuma ditambah id baru (rowRoot, lineTop, lineBottom, circleBg,
     iconCheck, iconClose, dotPending) utk elemen barunya. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_step_row_highlight"
    android:paddingHorizontal="4dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <!-- REDESIGN (permintaan user: "cek hijau jadi titik hijau kayak titik
         ungu, silang merah jadi titik merah juga"): ikon centang/silang
         putih di atas lingkaran solid pekat (iconCheck/iconClose) DIHAPUS.
         SEMUA status non-RUNNING sekarang pakai satu titik kecil polos yang
         sama (dotStatus, gaya PERSIS seperti titik teal di chip "Profil
         aktif" (lihat bg_dot_active_profile), cuma warnanya dimutasi per
         status di Kotlin (hijau/merah/abu-abu), lihat
         DashboardMainFragment.renderLogSteps(). Lingkaran badge di
         belakangnya (dot) juga ikut disamakan jadi warna LEMBUT/pastel utk
         semua status (bukan solid pekat lagi) supaya senada satu sama lain,
         cuma titik kecil di tengah yang jadi penanda warna status
         sebenarnya, id lama "dotPending" diganti nama jadi "dotStatus"
         karena sekarang dipakai utk SUCCESS & ERROR juga, bukan cuma
         PENDING. -->
    <LinearLayout
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <View
            android:id="@+id/lineTop"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/divider" />

        <FrameLayout
            android:layout_width="26dp"
            android:layout_height="26dp">

            <View
                android:id="@+id/dot"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_step_circle" />

            <View
                android:id="@+id/dotStatus"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dot_pending_small"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/spinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminateTint="@color/status_running" />
        </FrameLayout>

        <View
            android:id="@+id/lineBottom"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/divider" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:paddingVertical="2dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
