<?xml version="1.0" encoding="utf-8"?>
<!-- Layar "Konfigurasi" — tab TENGAH di bilah navigasi bawah, di antara
     "Dashboard" & "Pengaturan" (lihat ConfigActivity.setupBottomNav). Isinya
     jalan pintas ke SshConfigActivity & XrayConfigActivity, dipindah ke sini
     supaya kedua konfigurasi server itu punya akses satu-tap langsung dari
     bottom nav — sebelumnya cuma bisa lewat kartu "Menu" di halaman Main
     Dashboard, sekarang tetap ada di sana juga (tidak dihapus) sebagai jalan
     pintas tambahan. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Konfigurasi"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Atur profil server SSH &amp; Xray"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- REDESIGN (permintaan user: "profesional, modern, smooth").
                 Sebelumnya "Akun Tersimpan" satu kartu besar berisi
                 baris-baris akun dipisah garis tipis, dan tombol Impor/
                 Ekspor gampang mepet/tabrakan dengan judul di baris yang
                 sama. Sekarang: judul & aksi Impor/Ekspor jadi baris
                 header TERPISAH (bukan lagi di dalam satu kartu), lalu tiap
                 akun (llAccountsContainer, diisi DINAMIS lewat
                 ConfigActivity.refreshAccountsList()) jadi KARTU SENDIRI-
                 SENDIRI (lihat item_account_row.xml, style Card.Account) —
                 lebih mirip pola list modern (mis. kartu akun/kartu
                 pembayaran) daripada satu blok panjang bertumpuk.
                 llAccountEmpty (state belum ada akun) juga jadi kartu
                 sendiri, konsisten dengan kartu akun asli. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginBottom="10dp">

                <!-- BARU (permintaan user, modern/smooth): bar aksen gradasi
                     biru kecil di depan judul, gaya editorial. -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_section_accent_bar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Akun Tersimpan"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Kelola, bagikan, atau pindahkan akun Anda"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- FITUR BARU (permintaan user): Impor & Ekspor akun. Lihat
                     ConfigActivity.onImportClicked/onExportAllClicked &
                     model/ConfigIO.kt untuk format datanya. REDESIGN
                     (permintaan user, "fill biru smooth"): tombol sekarang
                     benar-benar diisi gradasi biru (bg_btn_brand_soft),
                     jadi teks & ikonnya diputihkan supaya kontras, bukan
                     lagi indigo di atas wash muda. -->
                <TextView
                    android:id="@+id/btnImportConfig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_brand_soft"
                    android:drawableStart="@drawable/ic_import"
                    android:drawablePadding="5dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_marginEnd="8dp"
                    android:text="Impor"
                    android:textColor="@color/brand_on_primary"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnExportAllConfig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_brand_soft"
                    android:drawableStart="@drawable/ic_export"
                    android:drawablePadding="5dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="Ekspor"
                    android:textColor="@color/brand_on_primary"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llAccountsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- State: BELUM ada konfigurasi tersimpan — kartu sendiri,
                 senada dengan kartu akun asli (Card.Account) supaya tidak
                 terasa seperti komponen lain sendiri di tengah daftar. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/llAccountEmpty"
                style="@style/Card.Account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_avatar_empty" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Belum ada akun ditambahkan. Tambahkan lewat Konfigurasi SSH atau Xray di bawah."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Konfigurasi Server (DIPINDAH ke bawah kartu "Akun
                 Tersimpan", permintaan user) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- BARU (permintaan user, modern/smooth): bar aksen
                             gradasi biru, senada dengan header "Akun
                             Tersimpan" di atas. -->
                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_section_accent_bar" />

                        <TextView
                            style="@style/SectionTitleText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="0dp"
                            android:text="Konfigurasi Server" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowConfigSsh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_avatar_ssh" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_account_ssh"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Konfigurasi SSH"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SSH, SSH SSL, SSH TLS Payload Proxy"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_forward"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/rowConfigXray"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_avatar_xray" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_account_xray"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Konfigurasi Xray"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VMess / VLESS / Trojan"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_forward"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bilah navigasi bawah, sama seperti Dashboard/Pengaturan: tab
         "Konfigurasi" aktif di layar ini. Lihat ConfigActivity.setupBottomNav(). -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.TunnelApp.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
