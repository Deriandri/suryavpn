<?xml version="1.0" encoding="utf-8"?>
<!-- Pill judul chip "Appearance/Language/Basic Settings/VPN Setting/About",
     sudut membulat + garis tepi tipis semi-transparan supaya terasa glossy.
     DIUBAH (permintaan user, "samakan warna dengan tombol Save Basic
     Settings"): sebelumnya gradasi biru laut (sea_blue_gradient_*) --
     sekarang gradasi indigo/ungu senada dengan brand_primary (warna
     backgroundTint tombol "Save Basic Settings", lihat Button.Primary di
     styles.xml & section_title_gradient_* di colors.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="@color/section_title_gradient_start"
        android:centerColor="@color/section_title_gradient_mid"
        android:endColor="@color/section_title_gradient_end" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
</shape>
