<?xml version="1.0" encoding="utf-8"?>
<!-- REDESIGN (permintaan user: modern/smooth): badge "✓ Aktif" sekarang
     gradasi hijau lembut + garis tepi tipis, bukan lagi warna hijau flat
     satu lapis, supaya terasa lebih "premium" konsisten dengan avatar
     gradasi di atas. Tetap hijau (bukan biru) karena ini status sukses. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#ECFDF3"
        android:endColor="#BBF7D0" />
    <corners android:radius="12dp" />
    <stroke android:width="1dp" android:color="#3316A34A" />
</shape>
