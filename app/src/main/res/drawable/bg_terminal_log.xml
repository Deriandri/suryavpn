<?xml version="1.0" encoding="utf-8"?>
<!-- Background area isi log (svTerminal). RIWAYAT: sempat diganti ke gradasi
     putih->biru muda, SEKARANG (permintaan terbaru user) balik ke HITAM,
     tapi "smooth" -- bukan hitam solid/flat begitu saja, melainkan gradasi
     halus dari abu-abu gelap ke hitam pekat, supaya masih ada sedikit
     kedalaman/dimensi (senada dengan gaya gradasi yang sudah dipakai di
     drawable lain di app ini), bukan warna datar sepenuhnya.
     angle=270 -> gradasi berjalan dari ATAS ke BAWAH. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="14dp" />
    <gradient
        android:angle="270"
        android:startColor="#1B1F24"
        android:centerColor="#101317"
        android:endColor="#000000" />
</shape>
