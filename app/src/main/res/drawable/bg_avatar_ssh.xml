<?xml version="1.0" encoding="utf-8"?>
<!-- REDESIGN (permintaan user: "fill biru smooth", modern & elegan) — avatar
     akun/baris "SSH" sekarang gradasi biru halus (bukan biru solid/flat),
     senada dengan bg_hero_gradient.xml, plus cincin tipis semi-transparan
     supaya terasa sedikit "glossy" seperti bg_hero_icon_badge.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="@color/hero_gradient_start"
        android:endColor="@color/brand_primary_dark" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
</shape>
