<?xml version="1.0" encoding="utf-8"?>
<!-- Latar kartu "hero" di paling atas halaman Main (ikon + status + profil
     aktif). Gradasi diagonal ungu brand supaya terasa lebih premium/modern
     dibanding kartu putih polos, dipakai sebagai android:background biasa
     (BUKAN cardBackgroundColor MaterialCardView, karena atribut itu cuma
     menerima warna solid, tidak bisa gradasi) - shape rounded-rect di sini
     otomatis dipakai sistem sebagai outline bayangan (elevation) juga. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="@color/hero_gradient_start"
        android:endColor="@color/hero_gradient_end" />
    <stroke
        android:width="1.5dp"
        android:color="#33FFFFFF" />
</shape>
