<?xml version="1.0" encoding="utf-8"?>
<!-- BARU (permintaan user, "kelayakan publish Play Store" -> adaptive
     icon): layer FOREGROUND untuk mipmap-anydpi-v26/ic_launcher.xml.
     Glyph shield yang sama persis dengan drawable/ic_app_icon.xml (path
     TIDAK diubah sama sekali), cuma dibungkus <group> dengan
     translate+scale supaya masuk ke "safe zone" 66dp yang center di
     kanvas 108dp -- wajib, kalau path aslinya dipakai apa adanya (edge-to-
     edge di viewport 24x24), launcher yang mask jadi lingkaran/squircle
     akan MEMOTONG ujung-ujung shield-nya.

     Perhitungan inset: (108-66)/2 = 21dp di tiap sisi, skala 66/24 = 2.75.
     Warna putih (brand_on_primary) supaya kontras di atas background ungu
     (@color/brand_primary di ic_launcher.xml/ic_launcher_round.xml) --
     pola yang SAMA seperti badge ikon header "Konfigurasi"/dashboard di
     bg_page_header_badge.xml (ikon putih di atas lingkaran ungu). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="21"
        android:translateY="21"
        android:scaleX="2.75"
        android:scaleY="2.75">
        <path
            android:fillColor="@color/brand_on_primary"
            android:pathData="M12,1L3,5v6c0,5.55 3.84,10.74 9,12 5.16,-1.26 9,-6.45 9,-12L21,5l-9,-4zM12,11.99h7c-0.53,4.12 -3.28,7.79 -7,8.94L12,11.99L5,11.99L5,6.3l7,-3.11v8.8z" />
    </group>
</vector>
