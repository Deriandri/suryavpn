<?xml version="1.0" encoding="utf-8"?>
<!-- REDESIGN (permintaan user: dialog "Impor konfigurasi" bergaya "glass"
     ungu-biru sesuai contoh gambar) — dipasang MANUAL lewat
     dialog.window?.setBackgroundDrawableResource(...) di
     ConfigActivity.onImportClicked(), BUKAN lewat android:windowBackground
     di tema, karena MaterialAlertDialogBuilder.create() selalu menimpa
     background window dengan MaterialShapeDrawable solid (dari
     colorSurface) setelah tema diterapkan — satu-satunya cara drawable
     gradasi ini benar-benar terpakai adalah memasangnya lagi setelah
     create(), sebelum show().
     Layer 1: gradasi dasar ungu-biru. Layer 2: sapuan highlight putih
     transparan diagonal (kesan "kaca") mengikuti sudut cahaya di gambar
     contoh (datang dari kanan-atas). Layer 3: garis tepi tipis putih
     transparan supaya kartu terasa punya batas kaca yang jelas. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/import_glass_bg_start"
                android:endColor="@color/import_glass_bg_end" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:type="linear"
                android:angle="115"
                android:startColor="#3DFFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
