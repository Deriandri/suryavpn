<?xml version="1.0" encoding="utf-8"?>
<!-- PENTING: tetap satu <shape> tunggal (bukan layer-list/selector).
     DashboardMainFragment.applyStatusPillColor() melakukan
     (pillStatus.background.mutate() as GradientDrawable) untuk ganti warna
     sesuai status, jadi root elemen ini wajib tetap GradientDrawable —
     <stroke> di sini AMAN ditambahkan (masih 1 GradientDrawable yang sama,
     cuma nambah properti garis tepi), dipakai untuk kesan "chip mengambang"
     yang lebih rapi di atas kartu hero (permintaan user: modernisasi
     tampilan status/profil aktif). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/status_pending_bg" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#1A000000" />
</shape>
