<!-- BARU (permintaan user: modern/smooth) — bar aksen kecil bergradasi biru
     di samping judul seksi ("Akun Tersimpan", "Konfigurasi Server"), gaya
     editorial modern supaya judul terasa lebih "bertaji" dibanding teks
     polos begitu saja. Murni dekoratif, tidak dipakai state apa pun. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="@color/hero_gradient_start"
        android:endColor="@color/brand_primary_dark" />
    <corners android:radius="3dp" />
</shape>
