<?xml version="1.0" encoding="utf-8"?>
<!-- REDESIGN (permintaan user: modern/smooth): chip tipe akun ("SSH"/
     "XRAY" di item_account_row.xml) sekarang gradasi biru lembut halus,
     bukan satu warna wash flat, senada dengan avatar gradasi & tombol
     Impor/Ekspor di bawah. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="@color/pill_brand_soft_bg_start"
        android:endColor="@color/pill_brand_soft_bg_end" />
    <corners android:radius="12dp" />
    <stroke android:width="1dp" android:color="#334F46E5" />
</shape>
