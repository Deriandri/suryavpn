<?xml version="1.0" encoding="utf-8"?>
<!-- REDESIGN dialog "Detail Ekspor": tombol "Lanjut" (positive) tampil
     sebagai pill gradasi teal->indigo, meniru tombol highlight di contoh
     gambar -- dipasang lewat android:background di
     TunnelApp.Dialog.Button.Positive.Export (themes.xml), BUKAN
     backgroundTint biasa, karena backgroundTint cuma bisa satu warna
     solid, sedangkan tombol di contoh gambar jelas gradasi dua warna. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="100dp" />
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/export_button_gradient_start"
        android:endColor="@color/export_button_gradient_end" />
</shape>
