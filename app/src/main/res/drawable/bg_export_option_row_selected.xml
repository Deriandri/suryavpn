<?xml version="1.0" encoding="utf-8"?>
<!-- REDESIGN dialog "Kunci konfigurasi?" (permintaan user: tampilan
     profesional & modern) -- varian "terpilih" dari bg_export_option_row,
     dipakai [ConfigActivity.buildLockModeRow] untuk baris mode kunci yang
     SEDANG dipilih user. Sama-sama kotak "kaca" bulat, tapi isi sedikit
     lebih solid & garis tepi memakai warna teal terang
     [export_glass_input_stroke_focused] (warna yang sama dipakai field
     "Nama ekspor" saat fokus di dialog Detail Ekspor) supaya jelas
     dibedakan dari baris lain yang belum dipilih, tanpa memakai warna
     baru di luar palet "glass" yang sudah ada. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="#66FFFFFF" />
    <stroke android:width="1.5dp" android:color="@color/export_glass_input_stroke_focused" />
</shape>
