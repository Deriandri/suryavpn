    <!-- Kartu: VPN Setting -->
    <string name="section_vpn">VPN Setting</string>
    <string name="dns_label">DNS</string>
    <string name="dns_desc">Kalau dinyalakan, DNS di bawah menimpa DNS profil SSH/Xray. Mati (default): DNS di sini diabaikan, tetap pakai DNS profil masing-masing.</string>
    <string name="dns_override_title">Timpa DNS</string>
    <string name="dns_override_desc">Aktifkan untuk memakai DNS 1/DNS 2 di bawah. Mati secara default.</string>
    <string name="dns1_hint">DNS 1 (mis. 8.8.8.8)</string>
    <string name="dns2_hint">DNS 2 (mis. 1.1.1.1)</string>
    <string name="mtu_hint">MTU (default 1500)</string>
    <string name="ports_desc">Kosongkan port di bawah untuk pakai default masing-masing profil. SOCKS5 Port menimpa port semua profil. HTTP Port menyalakan proxy HTTP lokal tambahan (chaining ke SOCKS5) untuk app yang cuma dukung proxy HTTP. UDPGW Port, kalau diisi, meneruskan UDP non-DNS (game, QUIC/HTTP3, VoIP) lewat proses badvpn-udpgw di server (server WAJIB sudah menjalankan badvpn-udpgw di port ini).</string>
    <string name="socks_port_hint">SOCKS5 Port (opsional)</string>
    <string name="http_port_hint">HTTP Port (opsional)</string>
    <string name="udpgw_port_hint">UDPGW Port (opsional)</string>
    <string name="udpgw_placeholder">mis. 7300 (default badvpn-udpgw)</string>
    <string name="keep_cpu_awake_title">Keep CPU Awake</string>
    <string name="keep_cpu_awake_desc">Cegah CPU tidur selagi tunnel aktif, biar koneksi tidak putus-putus di background</string>
    <string name="auto_reconnect_title">Auto Reconnect</string>
    <string name="auto_reconnect_desc">Nyambung ulang otomatis kalau tunnel putus sendiri (maks. 3x percobaan)</string>
    <string name="performance_mode_title">Performance Mode</string>
    <string name="performance_mode_desc">Aktifkan untuk mode full traffic (download, speedtest, dll). Kalau dimatikan, mode multi-tasking yang dipakai.</string>
    <string name="compression_title">Enable Compression</string>
    <string name="compression_hint">Compress trafik SSH pakai zlib -- mengurangi pemakaian data dengan sedikit overhead CPU.</string>
