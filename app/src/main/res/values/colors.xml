<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand -->
    <color name="brand_primary">#4F46E5</color>
    <color name="brand_primary_dark">#4338CA</color>
    <color name="brand_on_primary">#FFFFFF</color>
    <color name="brand_secondary">#0EA5A4</color>
    <!-- Pasangan gradasi teal untuk avatar "Xray" (permintaan user: tampilan
         Konfigurasi lebih modern/smooth) — dipakai bersama brand_secondary
         di bg_avatar_xray.xml supaya avatar Xray ikut gaya gradasi halus
         yang sama dengan avatar SSH (bg_avatar_ssh.xml, gradasi biru). -->
    <color name="brand_secondary_dark">#0C7A79</color>

    <!-- FITUR BARU (permintaan user, "cloud config"): pasangan gradasi ungu
         untuk avatar baris "Cloud Config" di ConfigActivity, sengaja beda
         hue dari SSH (biru, bg_avatar_ssh) & Xray (teal, bg_avatar_xray)
         supaya ketiga jenis baris tetap gampang dibedakan sekilas. -->
    <color name="cloud_gradient_start">#8B5CF6</color>
    <color name="cloud_gradient_end">#6D28D9</color>

    <!-- Surfaces -->
    <color name="app_background">#F3F4F6</color>
    <color name="card_background">#FFFFFF</color>
    <color name="divider">#E5E7EB</color>

    <!-- Text -->
    <color name="text_primary">#111827</color>
    <color name="text_secondary">#6B7280</color>
    <color name="text_hint">#9CA3AF</color>

    <!-- Hero card (Main dashboard): kartu status utama bergradasi ungu di
         paling atas halaman "Main" - warna teks/ikon di atasnya perlu versi
         terang tersendiri karena latar belakangnya gelap (bukan putih),
         beda dari text_primary/text_secondary yang didesain untuk latar
         terang biasa. -->
    <color name="hero_gradient_start">#6366F1</color>
    <color name="hero_gradient_end">#4338CA</color>
    <color name="hero_icon_badge_bg">#33FFFFFF</color>
    <color name="text_on_hero">#F5F3FF</color>
    <color name="text_on_hero_secondary">#C7D2FE</color>

    <!-- FITUR BARU (permintaan user, "tema dark"): warna-warna berikut
         sebelumnya di-hardcode langsung di file drawable (bg_btn_neutral_outline,
         bg_btn_edit_outline, bg_pill_active, bg_pill_brand_soft) sebagai hex
         literal. Dipindah jadi @color bernama di sini SUPAYA masing-masing
         bisa punya versi gelap terpisah lewat values-night/colors.xml.
         Kalau tetap hex literal di drawable, tombol/pill itu akan selalu
         tampil terang (mis. putih pekat) walau seluruh app sudah pindah ke
         tema gelap. Nilai di bawah ini SAMA PERSIS dengan hex asli, jadi
         tampilan tema terang tidak berubah sama sekali. -->
    <color name="btn_neutral_outline_start">#F9FAFB</color>
    <color name="btn_neutral_outline_end">#F1F5F9</color>
    <color name="btn_edit_outline_bg">#EEF2FF</color>
    <color name="pill_active_bg_start">#ECFDF3</color>
    <color name="pill_active_bg_end">#BBF7D0</color>
    <color name="pill_brand_soft_bg_start">#EEF2FF</color>
    <color name="pill_brand_soft_bg_end">#E0E7FF</color>

    <!-- BARU (permintaan user: label section di Settings dikasih logo +
         background "biru laut smooth") — pasangan gradasi biru laut,
         DULU sengaja beda hue dari brand_primary. SEKARANG (permintaan
         user, "samakan warna chip Appearance/Language/Basic Settings/VPN
         Setting/About dengan warna tombol Save Basic Settings") sudah
         TIDAK dipakai lagi di bg_section_title_seablue.xml , dibiarkan
         di sini (bukan dihapus) siapa tahu masih dipakai/dibutuhkan lagi
         nanti di tempat lain. -->
    <color name="sea_blue_gradient_start">#38BDF8</color>
    <color name="sea_blue_gradient_mid">#0EA5E9</color>
    <color name="sea_blue_gradient_end">#0369A1</color>

    <!-- BARU (permintaan user: chip judul section "Appearance/Language/
         Basic Settings/VPN Setting/About" disamakan warnanya dengan
         tombol "Save Basic Settings" , lihat Button.Primary di
         styles.xml, backgroundTint = brand_primary #4F46E5). Dibuat
         gradasi (bukan flat solid) supaya tetap terasa "smooth"/glossy
         seperti gaya chip sebelumnya, TAPI seluruh 3 stop-nya tetap
         satu keluarga indigo/ungu yang sama dengan brand_primary ,
         start sedikit lebih terang (hero_gradient_start), tengah PERSIS
         brand_primary, akhir PERSIS brand_primary_dark , jadi kalau
         dilihat sekilas warnanya senada dengan tombol Simpan itu, bukan
         cuma mirip-mirip. Dipakai di bg_section_title_seablue.xml. -->
    <color name="section_title_gradient_start">#6366F1</color>
    <color name="section_title_gradient_mid">#4F46E5</color>
    <color name="section_title_gradient_end">#4338CA</color>

    <!-- REDESIGN dialog "Impor konfigurasi" (permintaan user: gaya "glass"
         ungu-biru sesuai contoh gambar) — dipakai KHUSUS oleh
         ThemeOverlay.TunnelApp.Dialog.Import & Field.Pill.Import di
         themes.xml, lihat ConfigActivity.onImportClicked(). Sengaja warna
         tetap (tidak ikut values-night) karena kartu "kaca" ini memang
         dirancang selalu punya tampilan gradasi sendiri, terlepas dari
         mode terang/gelap sistem — sama seperti hero_gradient_start/end
         yang juga dikunci. -->
    <color name="import_glass_bg_start">#CBD0F5</color>
    <color name="import_glass_bg_end">#AEB6EC</color>
    <color name="import_glass_title_text">#15152E</color>
    <color name="import_glass_input_bg">#40FFFFFF</color>
    <color name="import_glass_input_stroke">#59FFFFFF</color>
    <color name="import_glass_placeholder">#6C6F92</color>
    <color name="import_glass_button_text">#28339C</color>
    <color name="import_pill_solid">#79E3DC</color>
    <color name="import_pill_text">#0A3B40</color>

    <!-- REDESIGN dialog "Detail Ekspor" (permintaan user: gaya "glass"
         ungu-teal sesuai contoh gambar, mirip pola import_glass_* di atas
         tapi kartu lebih terang/pucat & tombol utama gradasi teal->indigo,
         bukan pill solid teal seperti dialog Impor) — dipakai KHUSUS oleh
         ThemeOverlay.TunnelApp.Dialog.Export & Field.Underline.Export di
         themes.xml, lihat ConfigActivity.showExportDetailsDialog(). Sengaja
         warna tetap (tidak ikut values-night) karena kartu "kaca" ini
         memang dirancang selalu punya tampilan gradasi sendiri, sama
         seperti import_glass_* yang juga dikunci. -->
    <color name="export_glass_bg_start">#E2DFFC</color>
    <color name="export_glass_bg_end">#CFF0EA</color>
    <color name="export_glass_title_text">#15152E</color>
    <color name="export_glass_body_text">#5B5E82</color>
    <color name="export_glass_input_bg">#40FFFFFF</color>
    <color name="export_glass_input_stroke_idle">#3DFFFFFF</color>
    <color name="export_glass_input_stroke_focused">#2DD4BF</color>
    <color name="export_glass_placeholder">#7C7FA0</color>
    <color name="export_button_gradient_start">#2DD4BF</color>
    <color name="export_button_gradient_end">#6366F1</color>
    <color name="export_button_text">#FFFFFF</color>
    <color name="export_outline_button_text">#4F46E5</color>
    <color name="export_outline_button_stroke">#8B90D9</color>

    <!-- REDESIGN dialog "Pilih Akun untuk Diekspor" (permintaan user: gaya
         ceklis lingkaran hijau + tombol custom sesuai contoh gambar) —
         dipakai KHUSUS oleh baris akun & garis pemisah di
         [ConfigActivity.showExportAccountPicker]/[buildExportAccountRow].
         Sengaja warna tetap (tidak ikut values-night), sama alasannya
         dengan export_glass_* di atas — kartu "kaca" dialog ini memang
         dirancang selalu punya tampilan sendiri, terlepas dari mode
         gelap/terang sistem. -->
    <color name="export_check_gradient_start">#4ADE80</color>
    <color name="export_check_gradient_end">#16A34A</color>
    <color name="export_check_unchecked_stroke">#8B90D9</color>
    <color name="export_glass_divider">#26130F3D</color>

    <!-- REDESIGN kartu "Catatan" di Dashboard (permintaan user: latar
         biru smooth kehitaman) — dipakai KHUSUS oleh
         bg_card_notes_smooth.xml/fragment_dashboard_main.xml, pola sama
         dengan hero_gradient_start/end di atas (LinearLayout polos +
         android:background gradasi, BUKAN cardBackgroundColor
         MaterialCardView yang cuma bisa satu warna solid). Sengaja warna
         tetap (tidak ikut values-night) — kartu ini memang dirancang
         selalu gelap terlepas dari mode gelap/terang sistem, sama seperti
         terminal_background/hero_gradient_* yang juga dikunci. Teks di
         dalamnya ikut dikasih warna terang tersendiri (lihat
         text_on_notes_card di bawah) karena warna teks default
         (text_secondary/text_primary) didesain untuk kartu TERANG dan
         nyaris tidak kebaca di atas gradasi gelap ini. -->
    <color name="notes_card_gradient_start">#1B2A4A</color>
    <color name="notes_card_gradient_end">#05070D</color>
    <color name="text_on_notes_card">#F1F5F9</color>
    <color name="text_on_notes_card_secondary">#CBD5E1</color>

    <!-- Status -->
    <color name="status_success">#16A34A</color>
    <color name="status_success_bg">#DCFCE7</color>
    <color name="status_error">#DC2626</color>
    <color name="status_error_bg">#FEE2E2</color>
    <color name="status_running">#D97706</color>
    <color name="status_running_bg">#FEF3C7</color>
    <color name="status_pending">#9CA3AF</color>
    <color name="status_pending_bg">#F3F4F6</color>

    <!-- Terminal (kartu "Log"). RIWAYAT (permintaan user berubah pulang-pergi):
         awalnya gelap ala terminal klasik (hitam + hijau terang), sempat
         diganti ke tema terang "putih ke biruan", SEKARANG (permintaan
         terbaru) balik lagi ke background HITAM tapi smooth (gradasi
         halus, bukan hitam pekat/flat begitu saja); lihat
         drawable/bg_terminal_log.xml. Teks & timestamp ikut dibalik ke
         varian TERANG (kontras di atas hitam); kalau dipakai warna gelap
         versi tema putih sebelumnya (#15803D / #0891B2), nyaris tidak
         kebaca di atas hitam, sama seperti masalah kebalikannya dulu waktu
         hijau terang dipakai di atas putih. -->
    <color name="terminal_background">#FFFFFF</color>
    <color name="terminal_surface">#FFFFFF</color>
    <color name="terminal_text">#8FE38F</color>
    <color name="terminal_text_dim">#64748B</color>
    <color name="terminal_accent">@color/brand_secondary</color>
    <color name="terminal_divider">#E1E8F5</color>
    <!-- Warna khusus timestamp "[HH:mm:ss]" di setiap baris log (permintaan
         user), cyan TERANG supaya kontras di atas background hitam
         (kebalikan dari versi gelap #0891B2 yang dipakai waktu bg-nya
         masih putih). -->
    <color name="terminal_timestamp">#22D3EE</color>
    <!-- Warna durasi "(...ms)" pada baris "HTTP Ping"/"Keep-alive" di layar
         Log (permintaan user): BIRU kalau cepat (1-80ms), MERAH kalau
         lambat (85ms ke atas). Lihat MyVpnService.pingMsColorHex(). -->
    <color name="ping_ms_fast">#3B82F6</color>
    <color name="ping_ms_slow">@color/status_error</color>
</resources>
