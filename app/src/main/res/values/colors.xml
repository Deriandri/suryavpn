         dipakai di seluruh app, bukan abu-abu generik, supaya kartu ini
         terasa satu tema dengan Dashboard/Konfigurasi/Pengaturan. -->
    <color name="terminal_background">#0D0F14</color>
    <color name="terminal_surface">#12151C</color>
    <color name="terminal_text">#8FE38F</color>
    <color name="terminal_text_dim">#5D7A8C</color>
