<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- FITUR BARU (permintaan user, "tema dark"): sekarang pakai varian
         "DayNight", BUKAN "Light" lagi.

         RIWAYAT (penting supaya bug lama tidak terulang): dulu app ini
         SENGAJA dikunci ke "Light" karena "DayNight" polos pernah bikin
         teks jadi abu-abu sangat terang & tidak terbaca di mode gelap,
         itu terjadi karena ketika itu HANYA colorOnSurface/colorSurface dkk
         yang didefinisikan di sini, sedangkan values/colors.xml TIDAK
         punya padanan gelap sama sekali (app_background, card_background,
         text_primary, dst. cuma py satu nilai, didesain untuk latar
         terang), Material3 lalu mencampur warna gelap bawaannya sendiri
         dengan warna terang app ini, hasilnya kontras berantakan.

         SEKARANG diperbaiki dengan benar: ditambahkan padanan gelap yang
         LENGKAP di values-night/colors.xml (app_background, card_background,
         divider, text_primary/secondary/hint, wash pill/tombol, dst),
         sehingga setiap @color/xxx di bawah ini otomatis resolve ke versi
         gelap yang SUDAH didesain khusus, bukan bawaan Material3. Toggle
         Terang/Gelap/Ikuti Sistem ada di layar Pengaturan -> kartu
         "Tampilan" (lihat ThemeStore.kt & TunnelApplication.kt). -->
    <style name="Theme.TunnelApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSurface">@color/card_background</item>
        <!-- PENTING: ini yang sebenarnya mengontrol warna teks di dalam
             TextInputEditText, Chip (belum dipilih), dan komponen Material3
             lain yang tidak diberi android:textColor eksplisit. Tanpa ini,
             nilainya ikut default tema induk (bisa jadi terang kalau device
             dark mode, walau sekarang sudah dikunci ke "Light" di atas,
             didefinisikan eksplisit di sini supaya benar-benar pasti & tidak
             bergantung pada versi/варian Material3 yang dipakai). -->
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- REDESIGN (permintaan user: "tampilan modern, profesional, smooth"
             untuk dialog Impor/Ekspor/Kunci di ConfigActivity): sebelumnya
             semua AlertDialog di app ini (lihat ConfigActivity.kt) memakai
             androidx.appcompat.app.AlertDialog.Builder polos -> kotak putih
             bersudut TAJAM dengan gaya sistem default, kontras sekali dengan
             kartu bersudut bulat & aksen brand di seluruh layar lain app ini
             (lihat Card.Section/Card.Account di atas).

             materialAlertDialogTheme di sini mengarahkan SEMUA dialog yang
             dibangun lewat MaterialAlertDialogBuilder (lihat penggantian
             AlertDialog.Builder -> MaterialAlertDialogBuilder di
             ConfigActivity.kt) supaya otomatis bersudut bulat, tombol teks
             bergaya brand, judul lebih tegas -- tanpa perlu setiap pemanggil
             mengatur style manual satu-satu. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TunnelApp.Dialog</item>
    </style>

    <!-- Bungkus tema dialog: bentuk (shape), warna tombol & judul untuk
         SEMUA MaterialAlertDialogBuilder di app ini (lihat catatan
         materialAlertDialogTheme di atas). -->
    <style name="ThemeOverlay.TunnelApp.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TunnelApp.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.TunnelApp.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.TunnelApp.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.TunnelApp.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.TunnelApp.Dialog.Button.Neutral</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.TunnelApp.Dialog.Button.Neutral</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>

    <!-- Sudut membulat 24dp senada dengan Card.Account (20dp) & bottom
         sheet (lihat bg_bottom_sheet.xml) -- sedikit lebih besar karena
         dialog "melayang" di tengah, bukan menempel ke tepi kartu. -->
    <style name="ShapeAppearance.TunnelApp.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="TextAppearance.TunnelApp.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.TunnelApp.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Tombol positif ("Impor"/"Simpan"/"Lanjut"/"Hapus"/"Kunci", dst.):
         teks tebal warna brand, ripple bulat senada tombol lain di app ini. -->
    <style name="Widget.TunnelApp.Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/brand_primary</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Tombol batal/netral: abu-abu netral (bukan brand) supaya tombol
         positif tetap paling menonjol -- pola umum Material3 (satu aksi
         "utama" per dialog). -->
    <style name="Widget.TunnelApp.Dialog.Button.Neutral" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="rippleColor">@color/text_secondary</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Card.Section" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- REDESIGN (permintaan user: kartu Konfigurasi Akun jadi "profesional,
         modern, smooth"): tiap akun tersimpan sekarang kartu sendiri-sendiri
         (elevasi tipis + sudut lebih bulat) alih-alih baris polos bertumpuk
         di dalam satu kartu besar dengan garis pembatas — lihat
         item_account_row.xml & ConfigActivity.refreshAccountsList(). Elevasi
         sengaja dibuat lebih tipis dari Card.Section (1.2dp vs 2dp) supaya
         tetap terasa ringan/rapi walau banyak kartu ditumpuk berurutan. -->
    <style name="Card.Account" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1.2dp</item>
        <item name="contentPadding">14dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="SectionTitleText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Field.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <!-- Warna label/hint mengambang & border kotak dikunci eksplisit juga,
             supaya tidak ikut goyah oleh mode gelap/terang sistem seperti
             kasus warna teks isi field di atas. -->
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="boxStrokeErrorColor">@color/status_error</item>
    </style>

    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/brand_primary</item>
    </style>

    <style name="Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/status_error</item>
        <item name="android:textColor">@color/status_error</item>
    </style>

    <!-- Bilah navigasi bawah (Dashboard <-> Pengaturan). Warna item pakai
         selector bottom_nav_item_color (aktif = brand_primary, non-aktif =
         text_hint), background dikunci ke card_background + garis pemisah
         tipis di atasnya supaya konsisten dengan tema terang app ini
         (sama alasannya dengan Theme.TunnelApp di atas: tidak ikut dark mode
         sistem). -->
    <style name="Widget.TunnelApp.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/card_background</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemRippleColor">@color/divider</item>
        <item name="elevation">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- PENTING (fix bug tampilan): chip yang BELUM dipilih sebelumnya
         memakai warna teks default Material3 (colorOnSurfaceVariant) yang,
         sebelum fix tema di atas, bisa jadi sangat terang & sulit dibaca di
         atas kartu putih, persis seperti "SSH SSL + Payload" yang terlihat
         pudar di screenshot. Style ini mengunci warna teks & background chip
         baik saat dipilih maupun tidak, terlepas dari tema sistem. -->
    <style name="Widget.TunnelApp.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="chipStrokeColor">@color/divider</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>
</resources>

