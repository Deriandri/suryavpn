<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- FITUR BARU (permintaan user, "tema dark"): sekarang pakai varian
         "DayNight", BUKAN "Light" lagi.

         RIWAYAT (penting supaya bug lama tidak terulang): dulu app ini
         SENGAJA dikunci ke "Light" karena "DayNight" polos pernah bikin
         teks jadi abu-abu sangat terang & tidak terbaca di mode gelap,
         itu terjadi karena ketika itu HANYA colorOnSurface/colorSurface dkk
         yang didefinisikan di sini, sedangkan values/colors.xml TIDAK
         punya padanan gelap sama sekali (app_background, card_background,
         text_primary, dst. cuma py satu nilai, didesain untuk latar
         terang), Material3 lalu mencampur warna gelap bawaannya sendiri
         dengan warna terang app ini, hasilnya kontras berantakan.

         SEKARANG diperbaiki dengan benar: ditambahkan padanan gelap yang
         LENGKAP di values-night/colors.xml (app_background, card_background,
         divider, text_primary/secondary/hint, wash pill/tombol, dst),
         sehingga setiap @color/xxx di bawah ini otomatis resolve ke versi
         gelap yang SUDAH didesain khusus, bukan bawaan Material3. Toggle
         Terang/Gelap/Ikuti Sistem ada di layar Pengaturan -> kartu
         "Tampilan" (lihat ThemeStore.kt & TunnelApplication.kt). -->
    <style name="Theme.TunnelApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSurface">@color/card_background</item>
        <!-- PENTING: ini yang sebenarnya mengontrol warna teks di dalam
             TextInputEditText, Chip (belum dipilih), dan komponen Material3
             lain yang tidak diberi android:textColor eksplisit. Tanpa ini,
             nilainya ikut default tema induk (bisa jadi terang kalau device
             dark mode, walau sekarang sudah dikunci ke "Light" di atas,
             didefinisikan eksplisit di sini supaya benar-benar pasti & tidak
             bergantung pada versi/варian Material3 yang dipakai). -->
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Card.Section" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="strokeColor">@color/card_stroke</item>
    </style>

    <!-- REDESIGN (permintaan user: kartu Konfigurasi Akun jadi "profesional,
         modern, smooth"): tiap akun tersimpan sekarang kartu sendiri-sendiri
         (elevasi tipis + sudut lebih bulat) alih-alih baris polos bertumpuk
         di dalam satu kartu besar dengan garis pembatas — lihat
         item_account_row.xml & ConfigActivity.refreshAccountsList(). Elevasi
         sengaja dibuat lebih tipis dari Card.Section (1.2dp vs 2dp) supaya
         tetap terasa ringan/rapi walau banyak kartu ditumpuk berurutan. -->
    <style name="Card.Account" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1.2dp</item>
        <item name="contentPadding">14dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="strokeColor">@color/card_stroke</item>
    </style>

    <style name="SectionTitleText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Field.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <!-- Warna label/hint mengambang & border kotak dikunci eksplisit juga,
             supaya tidak ikut goyah oleh mode gelap/terang sistem seperti
             kasus warna teks isi field di atas. -->
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="boxStrokeErrorColor">@color/status_error</item>
        <item name="placeholderTextColor">@color/text_hint</item>
    </style>

    <!-- PERBAIKAN BUG TAMPILAN (dialog Detail Ekspor & lain-lain yang dibuat
         murni lewat Kotlin, tanpa XML): [dialogInputLayout] sebelumnya
         membungkus context dengan ContextThemeWrapper memakai
         [R.style.Field_Outlined] langsung sebagai "tema", tapi itu TIDAK sama
         dengan memasang style tersebut sebagai style widget-nya. TextInputLayout
         yang dibuat lewat constructor tanpa AttributeSet selalu mencari
         style-nya dari atribut tema `?attr/textInputStyle`
         (com.google.android.material.R.attr.textInputStyle), BUKAN dari
         atribut-atribut custom di dalam Field.Outlined (boxCornerRadius, dst)
         yang ikut "dicat" ke tema oleh ContextThemeWrapper. Karena tema app
         ini tidak pernah menimpa `textInputStyle`, TextInputLayout jatuh
         balik ke default Material3 (filled box / garis bawah polos), persis
         bug "kotak outline hilang" yang terlihat di dialog Impor/Ekspor.
         ThemeOverlay ini SATU-SATUNYA isinya adalah menimpa `textInputStyle`
         agar menunjuk ke Field.Outlined, sehingga begitu context dibungkus
         dengan overlay ini (bukan Field.Outlined langsung), constructor
         TextInputLayout(context) akan resolve `?attr/textInputStyle` ke
         Field.Outlined dengan benar, menghasilkan kotak outline bulat +
         garis ungu brand yang konsisten dengan field lain di app (lihat
         [dialogInputLayout] di ConfigActivity.kt). -->
    <style name="ThemeOverlay.TunnelApp.OutlinedField" parent="">
        <item name="textInputStyle">@style/Field.Outlined</item>
    </style>

    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/brand_primary</item>
    </style>

    <style name="Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/status_error</item>
        <item name="android:textColor">@color/status_error</item>
    </style>

    <!-- Bilah navigasi bawah (Dashboard <-> Pengaturan). Warna item pakai
         selector bottom_nav_item_color (aktif = brand_primary, non-aktif =
         text_hint), background dikunci ke card_background + garis pemisah
         tipis di atasnya supaya konsisten dengan tema terang app ini
         (sama alasannya dengan Theme.TunnelApp di atas: tidak ikut dark mode
         sistem). -->
    <style name="Widget.TunnelApp.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/card_background</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemRippleColor">@color/divider</item>
        <item name="elevation">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- PENTING (fix bug tampilan): chip yang BELUM dipilih sebelumnya
         memakai warna teks default Material3 (colorOnSurfaceVariant) yang,
         sebelum fix tema di atas, bisa jadi sangat terang & sulit dibaca di
         atas kartu putih, persis seperti "SSH SSL + Payload" yang terlihat
         pudar di screenshot. Style ini mengunci warna teks & background chip
         baik saat dipilih maupun tidak, terlepas dari tema sistem. -->
    <style name="Widget.TunnelApp.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="chipStrokeColor">@color/divider</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>

    <!-- REDESIGN (permintaan user: "bikin tampilan jadi profesional dan
         modern serta smooth"): dialog konfigurasi (Impor, Nama file ekspor,
         Kunci konfigurasi, Ekspor Semua Akun, dst di ConfigActivity.kt)
         sebelumnya pakai AlertDialog.Builder POLOS — tampil dengan gaya
         sistem default (kotak persegi tajam, judul tipis, tombol ALL CAPS
         biru generik) yang kontras sekali dengan kartu/tombol lain di app
         ini yang sudah bergaya Material3 modern. Theme overlay ini dipakai
         lewat MaterialAlertDialogBuilder(this, R.style.ThemeOverlay_TunnelApp_Dialog)
         di ConfigActivity.kt supaya SEMUA dialog otomatis: sudut membulat
         (lihat ShapeAppearance di bawah), judul bold, tombol berwarna brand
         ungu (bukan biru generik) & tanpa ALL CAPS, radio/checklist item
         (setSingleChoiceItems) ikut warna brand saat dipilih, serta
         transisi masuk/keluar yang smooth (fade + scale kecil, lihat
         res/anim/dialog_enter.xml & dialog_exit.xml) alih-alih pop instan
         bawaan sistem. -->
    <style name="ShapeAppearance.TunnelApp.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Animation.TunnelApp.Dialog" parent="Animation.AppCompat.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <style name="TunnelApp.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TunnelApp.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TunnelApp.Dialog.Button.Positive" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/btn_edit_outline_bg</item>
    </style>

    <style name="TunnelApp.Dialog.Button.Negative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TunnelApp.Dialog.Button.Neutral" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/brand_secondary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ThemeOverlay.TunnelApp.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog.Centered">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TunnelApp.Dialog</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TunnelApp.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TunnelApp.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/TunnelApp.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/TunnelApp.Dialog.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/TunnelApp.Dialog.Button.Neutral</item>
        <item name="android:windowAnimationStyle">@style/Animation.TunnelApp.Dialog</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>

    <!-- REDESIGN dialog "Impor konfigurasi" (permintaan user: gaya "glass"
         ungu-biru sesuai contoh gambar) — dipakai HANYA oleh dialog itu
         (lihat ConfigActivity.onImportClicked()), dialog lain di app ini
         tetap pakai ThemeOverlay.TunnelApp.Dialog biasa supaya tidak ikut
         berubah. Warna background kartu sendiri dipasang manual lewat
         drawable/bg_dialog_import_glass.xml (lihat komentar di file
         tersebut kenapa tidak cukup lewat android:windowBackground di
         sini) — colorSurface di bawah cuma cadangan tipis kalau
         MaterialShapeDrawable sempat kegambar sekilas sebelum ditimpa. -->
    <style name="ThemeOverlay.TunnelApp.Dialog.Import" parent="ThemeOverlay.TunnelApp.Dialog">
        <item name="colorSurface">@color/import_glass_bg_start</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TunnelApp.Dialog.Title.Import</item>
        <item name="buttonBarPositiveButtonStyle">@style/TunnelApp.Dialog.Button.Positive.Import</item>
        <item name="buttonBarNegativeButtonStyle">@style/TunnelApp.Dialog.Button.Negative.Import</item>
        <item name="buttonBarNeutralButtonStyle">@style/TunnelApp.Dialog.Button.Neutral.Import</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>

    <style name="TunnelApp.Dialog.Title.Import" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/import_glass_title_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
    </style>

    <!-- Tombol "Impor" (positive) tampil sebagai pill terisi warna
         teal/cyan lembut, meniru tombol highlight di contoh gambar —
         sengaja pakai Widget.Material3.Button (contained), BUKAN varian
         TextButton.Dialog seperti tombol lain, supaya benar-benar terisi
         warna, bukan teks polos. -->
    <style name="TunnelApp.Dialog.Button.Positive.Import" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/import_pill_solid</item>
        <item name="android:textColor">@color/import_pill_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#330A3B40</item>
    </style>

    <style name="TunnelApp.Dialog.Button.Negative.Import" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/import_glass_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">#1F28339C</item>
    </style>

    <style name="TunnelApp.Dialog.Button.Neutral.Import" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/import_glass_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">#1F28339C</item>
    </style>

    <!-- Kotak input di dialog Impor: pill penuh (bukan outline persegi
         seperti Field.Outlined), latar putih transparan ala kaca, tanpa
         label mengambang — cuma placeholder abu-abu di dalam kotak,
         persis contoh gambar. -->
    <style name="Field.Pill.Import" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundMode">filled</item>
        <item name="boxBackgroundColor">@color/import_glass_input_bg</item>
        <item name="boxCornerRadiusTopStart">28dp</item>
        <item name="boxCornerRadiusTopEnd">28dp</item>
        <item name="boxCornerRadiusBottomStart">28dp</item>
        <item name="boxCornerRadiusBottomEnd">28dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxStrokeColor">@color/import_glass_input_stroke</item>
        <item name="hintTextColor">@color/import_glass_placeholder</item>
        <item name="android:textColorHint">@color/import_glass_placeholder</item>
        <item name="placeholderTextColor">@color/import_glass_placeholder</item>
        <item name="android:layout_marginTop">18dp</item>
    </style>

    <!-- Sama polanya dengan ThemeOverlay.TunnelApp.OutlinedField: satu-
         satunya isi overlay ini adalah menimpa ?attr/textInputStyle,
         karena TextInputLayout(context) tanpa AttributeSet HANYA membaca
         style widget-nya lewat atribut tema itu. -->
    <style name="ThemeOverlay.TunnelApp.PillField.Import" parent="">
        <item name="textInputStyle">@style/Field.Pill.Import</item>
    </style>

    <!-- REDESIGN dialog "Detail Ekspor" (permintaan user: gaya "glass"
         ungu-teal sesuai contoh gambar) — pola sama dengan
         ThemeOverlay.TunnelApp.Dialog.Import di atas, dipakai HANYA oleh
         dialog itu (lihat ConfigActivity.showExportDetailsDialog()).
         Bedanya: kartu di sini lebih TERANG (lavender pucat, lihat
         bg_dialog_export_glass), jadi judul & body pakai warna teks
         GELAP (export_glass_title_text/body_text), bukan teks terang
         seperti dialog Impor yang kartunya lebih pekat. -->
    <style name="ThemeOverlay.TunnelApp.Dialog.Export" parent="ThemeOverlay.TunnelApp.Dialog">
        <item name="colorSurface">@color/export_glass_bg_start</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TunnelApp.Dialog.Title.Export</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TunnelApp.Dialog.Body.Export</item>
        <item name="buttonBarPositiveButtonStyle">@style/TunnelApp.Dialog.Button.Positive.Export</item>
        <item name="buttonBarNegativeButtonStyle">@style/TunnelApp.Dialog.Button.Negative.Export</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>

    <style name="TunnelApp.Dialog.Title.Export" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/export_glass_title_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TunnelApp.Dialog.Body.Export" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/export_glass_body_text</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Tombol "Lanjut" (positive): pill gradasi teal->indigo penuh, lihat
         bg_button_export_primary.xml — pakai android:background (BUKAN
         backgroundTint) supaya gradasi 2 warnanya benar-benar kepakai,
         insetTop/Bottom=0dp supaya Widget.Material3.Button tidak menambah
         padding vertikal bawaan yang bikin drawable custom ke-crop. -->
    <style name="TunnelApp.Dialog.Button.Positive.Export" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_export_primary</item>
        <item name="android:textColor">@color/export_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Tombol "Batal" (negative): pill outline tipis transparan, lihat
         bg_button_export_outline.xml. -->
    <style name="TunnelApp.Dialog.Button.Negative.Export" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:background">@drawable/bg_button_export_outline</item>
        <item name="android:textColor">@color/export_outline_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="rippleColor">#1F4F46E5</item>
    </style>

    <!-- Kotak input di dialog Detail Ekspor: gaya "filled" modern, sudut
         membulat di SEMUA sisi (rapikan tampilan, permintaan user) —
         BEDA dari Field.Outlined (outline tipis tanpa isi) maupun
         Field.Pill.Import (bulat penuh + tanpa label mengambang) cuma di
         warna isi kotaknya (translucent kaca) & posisi label. Label
         "Nama ekspor (opsional)"/"Catatan (opsional)" tetap dipasang lewat
         hintText mengambang. Garis tepi pakai
         color state list [export_field_stroke_selector] supaya berubah
         teal HANYA saat field itu sedang difokus (persis field "Nama
         ekspor" yang tampil menyala di contoh gambar, sedangkan "Catatan"
         yang belum difokus tetap garis putih transparan tipis). -->
    <style name="Field.Underline.Export" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundMode">filled</item>
        <item name="boxBackgroundColor">@color/export_glass_input_bg</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColor">@color/export_field_stroke_selector</item>
        <item name="hintTextColor">@color/export_glass_body_text</item>
        <item name="android:textColorHint">@color/export_glass_placeholder</item>
        <item name="placeholderTextColor">@color/export_glass_placeholder</item>
        <item name="android:layout_marginTop">18dp</item>
    </style>

    <!-- Sama polanya dengan ThemeOverlay.TunnelApp.OutlinedField/PillField.Import. -->
    <style name="ThemeOverlay.TunnelApp.UnderlineField.Export" parent="">
        <item name="textInputStyle">@style/Field.Underline.Export</item>
    </style>
</resources>

