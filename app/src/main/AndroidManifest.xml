<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Diperlukan mulai Android 14 (API 34) untuk foreground service tipe khusus -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Buat fitur "Keep CPU Awake" (VPN Setting) — MyVpnService pegang
         PowerManager.PARTIAL_WAKE_LOCK selama tunnel aktif kalau di-aktifkan. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Buat fitur "Battery Usage" (VPN Setting) — minta pengecualian dari
         Doze/App Standby lewat ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS,
         supaya sistem tidak membekukan tunnel di background. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- FITUR BARU (permintaan user, "bikin otomatis dengan izin user"): dipakai
         [com.example.tunnelapp.ConfigActivity] supaya bisa TULIS LANGSUNG ke folder
         Download/SuryaVPN/ tanpa dialog file-picker tiap kali ekspor. maxSdkVersion=28
         karena mulai Android 10 (API 29) scoped storage berlaku, MediaStore API
         (dipakai lewat jalur MediaStore.Downloads di ConfigActivity) tidak butuh izin
         ini sama sekali, cuma perangkat Android 9 ke bawah yang masih perlu. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".TunnelApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.TunnelApp"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".DashboardActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SshConfigActivity"
            android:exported="false"
            android:label="Konfigurasi SSH" />

        <activity
            android:name=".XrayConfigActivity"
            android:exported="false"
            android:label="Konfigurasi Xray" />

        <!-- LogActivity dihapus: layar Log sekarang jadi halaman kanan
             Dashboard (geser kesamping / tab "Log") — lihat
             DashboardLogFragment & DashboardPagerAdapter. -->

        <!-- singleTop: dibuka dari tab "Konfigurasi" (tab tengah, baru) di
             bilah navigasi bawah — lihat ConfigActivity & bottom_nav_menu.xml. -->
        <activity
            android:name=".ConfigActivity"
            android:exported="false"
            android:label="Konfigurasi"
            android:launchMode="singleTop" />

        <!-- singleTop: dibuka dari tab "Pengaturan" di bilah navigasi bawah,
             kalau instance-nya sudah di puncak back stack, tap ulang tidak
             numpuk instance baru. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Pengaturan"
            android:launchMode="singleTop" />

        <!-- singleTop: tab ke-4 (baru) di bilah navigasi bawah, di samping
             "Pengaturan" - lihat ToolsActivity & bottom_nav_menu.xml. -->
        <activity
            android:name=".ToolsActivity"
            android:exported="false"
            android:label="Tools"
            android:launchMode="singleTop" />

        <service
            android:name=".tunnel.MyVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN tunnel service" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>
</manifest>
