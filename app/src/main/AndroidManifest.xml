<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- FITUR BARU (per-app proxy, AppFilterActivity): package visibility
         Android 11+ (API 30) — tanpa ini queryIntentActivities() di
         AppFilterActivity cuma akan melihat app ini sendiri, app lain tidak
         akan muncul di daftar pemilih. Dibatasi ke intent MAIN/LAUNCHER
         saja (bukan QUERY_ALL_PACKAGES yang lebih invasif & butuh justifikasi
         khusus ke Play Store) — cukup untuk enumerasi app yang punya
         launcher icon, yang memang satu-satunya yang relevan untuk fitur ini. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Diperlukan mulai Android 14 (API 34) untuk foreground service tipe khusus -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- FITUR BARU: dipakai BootCompletedReceiver untuk memasang ulang alarm
         Subscription auto-update (lihat SubscriptionAutoUpdateScheduler)
         setelah device reboot — AlarmManager membatalkan semua alarm
         terjadwal setiap reboot, ini yang memasangnya lagi. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Buat fitur "Keep CPU Awake" (VPN Setting) — MyVpnService pegang
         PowerManager.PARTIAL_WAKE_LOCK selama tunnel aktif kalau di-aktifkan. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Buat fitur "Battery Usage" (VPN Setting) — minta pengecualian dari
         Doze/App Standby lewat ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS,
         supaya sistem tidak membekukan tunnel di background. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- FITUR BARU (permintaan user, "bikin otomatis dengan izin user"): dipakai
         [com.example.tunnelapp.ConfigActivity] supaya bisa TULIS LANGSUNG ke folder
         Download/SuryaVPN/ tanpa dialog file-picker tiap kali ekspor. maxSdkVersion=28
         karena mulai Android 10 (API 29) scoped storage berlaku, MediaStore API
         (dipakai lewat jalur MediaStore.Downloads di ConfigActivity) tidak butuh izin
         ini sama sekali, cuma perangkat Android 9 ke bawah yang masih perlu. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".TunnelApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.TunnelApp"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".DashboardActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SshConfigActivity"
            android:exported="false"
            android:label="@string/title_ssh_config" />

        <activity
            android:name=".XrayConfigActivity"
            android:exported="false"
            android:label="@string/title_xray_config" />

        <!-- LogActivity dihapus: layar Log sekarang jadi halaman kanan
             Dashboard (geser kesamping / tab "Log") — lihat
             DashboardLogFragment & DashboardPagerAdapter. -->

        <!-- singleTop: dibuka dari tab "Konfigurasi" (tab tengah, baru) di
             bilah navigasi bawah — lihat ConfigActivity & bottom_nav_menu.xml. -->
        <activity
            android:name=".ConfigActivity"
            android:exported="false"
            android:label="@string/nav_config"
            android:launchMode="singleTop" />

        <!-- singleTop: dibuka dari tab "Pengaturan" di bilah navigasi bawah,
             kalau instance-nya sudah di puncak back stack, tap ulang tidak
             numpuk instance baru. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/nav_settings"
            android:launchMode="singleTop" />

        <!-- singleTop: tab ke-4 (baru) di bilah navigasi bawah, di samping
             "Pengaturan" - lihat ToolsActivity & bottom_nav_menu.xml. -->
        <activity
            android:name=".ToolsActivity"
            android:exported="false"
            android:label="@string/nav_tools"
            android:launchMode="singleTop" />

        <!-- FITUR BARU: layar Per-App Proxy, dibuka dari tab Tools. Bukan
             singleTop/root nav — ini layar "anak" biasa (back = kembali ke
             Tools), jadi tidak perlu masuk pola sibling 4-tab di atas. -->
        <activity
            android:name=".AppFilterActivity"
            android:exported="false"
            android:label="Per-App Proxy" />

        <!-- FITUR BARU: layar Routing & Performa (bypass LAN, mux, bypass
             domain/IP), dibuka dari tab Tools. -->
        <activity
            android:name=".RoutingSettingsActivity"
            android:exported="false"
            android:label="Routing &amp; Performa" />

        <!-- FITUR BARU: penerima alarm Subscription auto-update. exported
             false — HANYA dipicu PendingIntent milik app ini sendiri
             (lihat SubscriptionAutoUpdateScheduler), tidak menerima intent
             dari app lain sama sekali. -->
        <receiver
            android:name=".tunnel.SubscriptionAutoUpdateReceiver"
            android:exported="false" />

        <!-- FITUR BARU: memasang ulang alarm di atas setelah device reboot
             (lihat kdoc BootCompletedReceiver). exported=true WAJIB karena
             broadcast BOOT_COMPLETED memang dikirim sistem, bukan app ini
             sendiri — tapi dibatasi lewat intent-filter jadi tetap hanya
             bereaksi ke broadcast itu. -->
        <receiver
            android:name=".tunnel.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".tunnel.MyVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN tunnel service" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>
</manifest>
